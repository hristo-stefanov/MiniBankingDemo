@startuml
'https://plantuml.com/activity-diagram-beta

|system|
start
note right
Start event trigger:
User selects "Transfer Round-up"?
endnote

|user|
:Select an account from Accounts and Round-ups Summary
to transfer Round-up from;
'passed to SavingsGoalsFragment
-> [accountId,
accountCurrency,
roundUpAmount];

|system|

'ListSavingGoalsInteractor
: <&cog> Fetch savings goals;
-> [Result];

'SavingsGoalsViewModel
if () then ([is Service Error])
    'displays a dialog, not a snackbar
    'doesn't return to the main screen
    :Present unrecoverable error message; <<sendSignal>>
    stop
endif
-> [is Result set];

:Present Savings Goals Summary; <<sendSignal>>
|user|
:Select savings goal
(extension point: Savings Goals CRUD);
|system|
'passed to TransferConfirmationFragment
->[savingsGoal,
roundUpAmount,
accountCurrency,
accountId]
;

repeat
'TransferConfirmationViewModel
:Summarize transfer;

|user|
:Confirm transfer;
-> [accountId,
savingsGoalId,
accountCurrency,
roundUpAmount];
|system|
'AddMoneyIntoGoalInteractor
: <&cog> Add money into goal;
-> [Result];

'displays a dialog, not a snackbar
backward: Present unrecoverable error message; <<sendSignal>>

repeat while () is ([is Service Error])
-> [OK];

'TransferConfirmationViewModel
'and returns to the main screen - navigationChannel.send(Navigation.Before(R.id.savingsGoalsDestination))
:Send success acknowledgement; <<sendSignal>>

stop

@enduml
