@startuml
'https://plantuml.com/use-case-diagram

left to right direction
actor User <<Human>>
actor Bank <<Service>>

rectangle System {
usecase Startup
usecase Logout
usecase "Transfer Round-up"
usecase "Create Savings Goal"
usecase "Present 'Accounts and Round-ups'"
}

User -- Startup
User -- "Transfer Round-up"
User -- "Create Savings Goal"
User -- "Logout"

Startup .> "Present 'Accounts and Round-ups'"
"Transfer Round-up" .> "Present 'Accounts and Round-ups'"
"Present 'Accounts and Round-ups'" -- "Bank"
"Transfer Round-up" -- "Bank"
"Create Savings Goal" -- "Bank"
@enduml