@startuml
'https://plantuml.com/use-case-diagram

' Level: User Goals

left to right direction
actor User <<Human>>
actor Bank <<Service>>

rectangle System {
usecase "Present Summary"
usecase "Log out"
usecase "Ensure Login Credentials"
usecase "Transfer Round-up"
usecase "Create Savings Goal"
}

User -- "Present Summary"
User -- "Transfer Round-up"
User -- "Create Savings Goal"
User -- "Log out"

"Present Summary" -- "Bank"
"Present Summary" .> "Ensure Login Credentials": <<includes>>
'"Create Savings Goal" .> "Transfer Round-up" : <<extends>>
"Transfer Round-up" -- "Bank"
"Create Savings Goal" -- "Bank"
@enduml