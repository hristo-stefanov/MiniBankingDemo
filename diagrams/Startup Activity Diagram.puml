@startuml
'https://plantuml.com/activity-diagram-beta
|system|
start
while ()
:<&script> Query "has saved login credentials";
-> [flag];
if () then ([flag == yes])
else ([flag == no])
    |user|
    :<&person> Submit login credentials;
    -> [Login credentials];
    |system|
    : <&script> Save login credentials;
endif
    :⊞ Present Accounts and Roundups
    Summary;
    -> [Result];
    if () then  ([is Auth Error])
        :Present error message >
        :<&script> Clear user data and credentials;
    elseif () then ([is OK])
        stop
    else
        end
    endif
end while
-[hidden]->
@enduml
